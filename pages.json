{
	"leftWindow": {
		"path": "windows/left-window.vue",
		"style": {
			"width": "350px"
		}
	},
	"topWindow": {
		"path": "windows/top-window.vue",
		"style": {
			"height": "60px"
		}
	},
	"pages": [
		// pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/circle/circle",
			"style": {
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/circle/detail",
			"style": {
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/user/user",
			"style": {
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/profile/profileNew",
			"style": {
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/profile/profileDetail",
			"style": {
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/circle/create",
			"style": {
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/login/login",
			"style": {
				"navigationStyle": "custom"
			}
		}
	],
	"globalStyle": {
		"pageOrientation": "portrait",
		"navigationBarTitleText": "Hello uniapp",
		"navigationBarTextStyle": "black",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8",
		"backgroundColorTop": "#F4F5F6",
		"backgroundColorBottom": "#F4F5F6"
	},
	"tabBar": {
		"color": "#999999",
		"selectedColor": "#ff2442",
		"backgroundColor": "#ffffff",
		"borderStyle": "black",
		"list": [
			{
				"pagePath": "pages/circle/circle",
				"iconPath": "/static/home.png",
				"selectedIconPath": "/static/home-selected.png"
			},
			{
				"pagePath": "pages/user/user",
				"iconPath": "/static/person.png",
				"selectedIconPath": "/static/person-selected.png"
			}
		]
	}
}
