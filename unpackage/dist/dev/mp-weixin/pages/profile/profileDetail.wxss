}
.profile-detail-container .user-info.data-v-c6f6b7fe {
  background-color: #fff;
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 20px;
  margin-bottom: 10px;
}
.profile-detail-container .user-info .avatar-wrapper.data-v-c6f6b7fe {
  width: 80px;
